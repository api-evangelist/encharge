{
  "opencollection": "1.0.0",
  "info": {
    "name": "Encharge REST Account Segments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Encharge-Token",
      "value": "{{X-Encharge-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Segments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.encharge.io/v1/segments"
          },
          "docs": "List segments"
        },
        {
          "info": {
            "name": "List people in segment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.encharge.io/v1/segments/:segmentId/people",
            "params": [
              {
                "name": "segmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List people in segment"
        }
      ]
    }
  ],
  "bundled": true
}