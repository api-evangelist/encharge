{
  "opencollection": "1.0.0",
  "info": {
    "name": "Encharge REST Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Encharge-Token",
      "value": "{{X-Encharge-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.encharge.io/v1/accounts/info"
          },
          "docs": "Get account info"
        }
      ]
    }
  ],
  "bundled": true
}